  "allowed_patches": {
    "app/main.py": "Optional user-owned writable-path environment hooks; redact Kuaishou share query values from public responses.",
    "app/models.py": "Add the Kuaishou platform enum without changing existing values; add a whitelisted local diagnostic category field to the job and item records.",
    "app/platforms.py": "Recognize strictly validated Kuaishou video, profile and share URLs.",
    "app/downloader.py": "Connect original Kuaishou discovery to the existing verified media transfer, proxy, progress and cancellation paths; download one video from its single filtered candidate set; fully decode each album image before publication; persist source and local-byte SHA-256 receipts and conservatively verify them before reuse, including non-first codec candidates; hash in cancellable bounded chunks; share one per-platform output directory calculation.",
    "app/task_manager.py": "Bind resolved Kuaishou share identities and preserve incomplete-profile retry semantics; persist whitelisted asset receipts with SHA-256 evidence, merging incremental updates without losing later saved members; keep unmatched Kuaishou profile items queued while discovery is incomplete; reuse the shared output directory calculation; and carry the whitelisted Cookie diagnostic category into task state.",
    "app/static/app.js": "Add Kuaishou labels, localized progress and error guidance; recognize resolved share profile jobs; localize each whitelisted Chrome Cookie diagnostic category with its own guidance; localize profile interruption, bounded retry status and the skipped-work reason summary instead of collapsing into one generic message.",
    "app/static/index.html": "Advertise Kuaishou single-video, share and author-profile inputs with login and permission guidance.",
    "tests/test_stop.py": "Isolate the no-server test from real localhost services and cover a disappearing legacy listener; production stop.py is unchanged.",
    "app/browser.py": "Add safe Chrome Cookie access diagnostics without exposing profile paths or cookie values; the diagnostic probe falls back to a fixed category on its own filesystem errors instead of masking the original cookie failure.",
    "app/douyin_signing.py": "Include sanitized Chrome Cookie diagnostic categories in cookie-unavailable errors, carried as a whitelisted structured code that is never relabelled as a signing integrity failure.",
    "tests/test_signing_diagnostics.py": "Test sanitized Chrome Cookie diagnostic categories, the diagnostic helper's own filesystem-error fallback, control-signal propagation, and whitelisted structured codes through the signing chain."
  },
